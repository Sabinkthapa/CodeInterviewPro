[app]
title = Shopping List
package.name = shoppinglist
package.domain = org.example
source.dir = .
source.include_exts = py,png,kv
source.exclude_dirs = tests,bin,.buildozer
version = 1.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.api = 34
android.minapi = 24
android.archs = arm64-v8a, armeabi-v7a

[buildozer]
log_level = 2
warn_on_root = 1
